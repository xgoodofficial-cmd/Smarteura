{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered user profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "phone": { "type": "string", "maxLength": 50 },
        "company": { "type": "string", "maxLength": 120 },
        "notes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "ContactSubmission": {
      "title": "ContactSubmission",
      "description": "User inquiries and messages",
      "type": "object",
      "properties": {
        "fullName": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 50 },
        "serviceId": { "type": "string", "maxLength": 50 },
        "projectBrief": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "maxLength": 30 }
      },
      "required": ["fullName", "email", "serviceId", "projectBrief"]
    },
    "ClientInquiry": {
      "title": "ClientInquiry",
      "description": "B2B client inquiries for industrial projects",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "referenceId": { "type": "string", "maxLength": 64 },
        "companyName": { "type": "string", "maxLength": 150 },
        "contactPerson": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "maxLength": 160 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["companyName", "contactPerson", "email"]
    },
    "CandidateApplication": {
      "title": "CandidateApplication",
      "description": "Job and workforce applications submitted by candidates",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "referenceId": { "type": "string", "maxLength": 64 },
        "fullName": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "maxLength": 160 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fullName", "email"]
    },
    "TestConnection": {
      "title": "TestConnection",
      "description": "Test doc for verifying connection",
      "type": "object",
      "properties": {
        "status": { "type": "string", "maxLength": 50 }
      }
    },
    "GalleryItem": {
      "title": "GalleryItem",
      "description": "Worksites and technical gallery images",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "category": { "type": "string", "maxLength": 60 },
        "location": { "type": "string", "maxLength": 120 },
        "year": { "type": "string", "maxLength": 20 }
      },
      "required": ["id", "imageUrl", "category"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile collection accessible by the owner or admin"
    },
    "/contact_submissions/{submissionId}": {
      "schema": "ContactSubmission",
      "description": "Contact inquiries submitted by users and readable only by admins"
    },
    "/client_inquiries/{inquiryId}": {
      "schema": "ClientInquiry",
      "description": "Industrial client project inquiries accessible strictly to admins"
    },
    "/candidate_applications/{applicationId}": {
      "schema": "CandidateApplication",
      "description": "Candidate CV and trade applications accessible strictly to admins"
    },
    "/gallery/{itemId}": {
      "schema": "GalleryItem",
      "description": "Worksites and industrial gallery items readable publicly and managed by admins"
    },
    "/test/{docId}": {
      "schema": "TestConnection",
      "description": "Connection test documents"
    }
  }
}
