rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['xgoodofficial@gmail.com', 'admin@smarteura.eu', 'office@smarteura.eu'] ||
        request.auth.token.admin == true
      );
    }

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection check
    match /test/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Users collection - strictly isolated per user; admins can audit
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isOwner(userId)
        && incoming().uid == request.auth.uid
        && incoming().email is string
        && incoming().email.size() <= 256;
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Contact submissions - Public write with field validation, Admin-only read/manage
    match /contact_submissions/{submissionId} {
      allow create: if isValidId(submissionId)
        && incoming().fullName is string && incoming().fullName.size() <= 120
        && incoming().email is string && incoming().email.size() <= 160
        && incoming().projectBrief is string && incoming().projectBrief.size() <= 2000;
      allow read, list, update, delete: if isAdmin();
    }

    // Client Inquiries - Public write with field validation, Admin-only read/manage
    match /client_inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId)
        && incoming().companyName is string && incoming().companyName.size() <= 150
        && incoming().contactPerson is string && incoming().contactPerson.size() <= 120
        && incoming().email is string && incoming().email.size() <= 160;
      allow read, list, update, delete: if isAdmin();
    }

    // Candidate Applications - Public application submission, Admin-only read/manage
    match /candidate_applications/{applicationId} {
      allow create: if isValidId(applicationId)
        && incoming().fullName is string && incoming().fullName.size() <= 120
        && incoming().email is string && incoming().email.size() <= 160;
      allow read, list, update, delete: if isAdmin();
    }
  }
}
